rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'bangiscoder@gmail.com';
    }

    function isValidFeedback() {
      let data = request.resource.data;
      return data.keys().hasAll(['submittedAt', 'likesSoilwise', 'wouldUse', 'willingnessToPay']) &&
             data.likesSoilwise is string && data.likesSoilwise.size() <= 50 &&
             data.wouldUse is string && data.wouldUse.size() <= 50 &&
             data.willingnessToPay is string && data.willingnessToPay.size() <= 100 &&
             (!('language' in data) || (data.language is string && data.language.size() <= 10)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('userType' in data) || (data.userType is string && data.userType.size() <= 80)) &&
             (!('respondentRole' in data) || (data.respondentRole is string && data.respondentRole.size() <= 80)) &&
             (!('isFarmer' in data) || data.isFarmer is bool) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('cropsGrown' in data) || data.cropsGrown is list) &&
             (!('otherCrop' in data) || (data.otherCrop is string && data.otherCrop.size() <= 200)) &&
             (!('soilTested' in data) || (data.soilTested is string && data.soilTested.size() <= 50)) &&
             (!('soilTestMethod' in data) || (data.soilTestMethod is string && data.soilTestMethod.size() <= 150)) &&
             (!('otherSoilTestMethod' in data) || (data.otherSoilTestMethod is string && data.otherSoilTestMethod.size() <= 250)) &&
             (!('weatherInformationSource' in data) || (data.weatherInformationSource is string && data.weatherInformationSource.size() <= 100)) &&
             (!('otherWeatherInformationSource' in data) || (data.otherWeatherInformationSource is string && data.otherWeatherInformationSource.size() <= 250)) &&
             (!('farmDecisionChallenge' in data) || (data.farmDecisionChallenge is string && data.farmDecisionChallenge.size() <= 3000)) &&
             (!('removeOrModify' in data) || (data.removeOrModify is string && data.removeOrModify.size() <= 3000)) &&
             (!('desiredFeatures' in data) || (data.desiredFeatures is string && data.desiredFeatures.size() <= 3000)) &&
             (!('mostValuableFeature' in data) || (data.mostValuableFeature is string && data.mostValuableFeature.size() <= 100)) &&
             (!('joinWaitingList' in data) || data.joinWaitingList is bool) &&
             (!('consent' in data) || data.consent is bool);
    }

    match /soilwise_feedback/{feedbackId} {
      // Public can only create valid feedback documents
      allow create: if isValidFeedback();

      // Only authorized admin (bangiscoder@gmail.com) can read, update, or delete
      allow read, update, delete: if isAdmin();
    }

    match /users/{uid} {
      // User can read their own profile; Admin can read all
      allow read: if isOwner(uid) || isAdmin();

      // User can create their own profile on registration or initial sync
      // Role defaults to 'user' for public users, or admin for designated admin email
      allow create: if (isOwner(uid) &&
                       request.resource.data.uid == uid &&
                       ((!('role' in request.resource.data)) || request.resource.data.role == 'user' || isAdmin()) &&
                       ((!('admin' in request.resource.data)) || request.resource.data.admin == false || isAdmin())
                      ) || isAdmin();

      // User can update their own profile fields and preferences (displayName, photoURL, phoneNumber, state, lga, bio, farm details, profile, activeFarmId, etc.)
      // Cannot elevate privileges (role, accountStatus, admin) or reassign uid
      allow update: if (isOwner(uid) &&
                        (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
                        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin()) &&
                        (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin || isAdmin()) &&
                        (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == resource.data.accountStatus || isAdmin())
                       ) || isAdmin();

      // Only admin can delete user profiles
      allow delete: if isAdmin();

      // User-owned farms subcollection (Stage 3)
      match /farms/{farmId} {
        // Owner can read their own farms; Admin can read all
        allow read: if isOwner(uid) || isAdmin();

        // Owner can create a farm for their own account
        allow create: if isOwner(uid) &&
                         request.resource.data.userId == uid &&
                         request.resource.data.farmId == farmId;

        // Owner can update their own farm; userId cannot be transferred
        allow update: if (isOwner(uid) && request.resource.data.userId == uid) || isAdmin();

        // Owner can delete their own farm; Admin can delete any
        allow delete: if isOwner(uid) || isAdmin();
      }

      // User-owned analysis history subcollection
      match /analyses/{analysisId} {
        // Owner can read and list their own analyses; Admin can read all
        allow read: if isOwner(uid) || isAdmin();

        // Owner can save an analysis snapshot
        // Must tie userId to their own auth UID and match analysisId
        allow create: if isOwner(uid) &&
                         request.resource.data.userId == uid &&
                         request.resource.data.analysisId == analysisId;

        // Snapshots are immutable historical records; regular user updates are blocked
        allow update: if isAdmin();

        // Owner can delete their own analysis; Admin can delete any
        allow delete: if isOwner(uid) || isAdmin();
      }

      // User-owned learning progress subcollection
      match /learning/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // SoilWise Learning Hub published curriculum lessons
    // Public read-accessible to empower smallholder farmers with practical education
    // Only verified administrator (bangiscoder@gmail.com) may create, update, or delete lessons
    match /learning_lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // SoilWise Farm Inputs & Seed Marketplace
    // Public read-accessible for smallholder farmers to explore available certified crop seeds & stock
    // Only verified administrator (bangiscoder@gmail.com) can add seed varieties or modify stock/pricing
    match /marketplace_seeds/{seedId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Farmer Seed Orders & Reservations
    // Farmers can submit orders specifying crop seed and kilograms
    // Farmers can view their own orders; admin can view and update order fulfillment status
    match /marketplace_orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'seedId', 'quantityKg', 'farmerName', 'farmerPhone']) &&
                       request.resource.data.quantityKg is number && request.resource.data.quantityKg > 0 &&
                       request.resource.data.farmerName is string && request.resource.data.farmerName.size() <= 150 &&
                       request.resource.data.farmerPhone is string && request.resource.data.farmerPhone.size() <= 50;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
