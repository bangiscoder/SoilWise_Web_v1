{
  "entities": {
    "Feedback": {
      "title": "SoilWise Feedback Submission",
      "description": "Public product validation, farming background, and waiting list submission from farmers and agricultural stakeholders.",
      "type": "object",
      "properties": {
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp of submission."
        },
        "name": {
          "type": "string",
          "description": "Name of respondent (optional)."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of respondent."
        },
        "email": {
          "type": "string",
          "description": "Email address of respondent."
        },
        "userType": {
          "type": "string",
          "description": "Category of respondent (Farmer, Agronomist, etc.)."
        },
        "respondentRole": {
          "type": "string",
          "description": "Role of respondent."
        },
        "isFarmer": {
          "type": "boolean",
          "description": "Whether the respondent is a farmer."
        },
        "location": {
          "type": "string",
          "description": "Farm location or state/town."
        },
        "cropsGrown": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Crops cultivated or worked with."
        },
        "otherCrop": {
          "type": "string",
          "description": "Specification for other crops grown."
        },
        "soilTested": {
          "type": "string",
          "description": "Soil testing experience (Yes, No, I am not sure)."
        },
        "soilTestMethod": {
          "type": "string",
          "description": "Method or service used to test soil."
        },
        "otherSoilTestMethod": {
          "type": "string",
          "description": "Specification for other soil testing method."
        },
        "weatherInformationSource": {
          "type": "string",
          "description": "Primary channel used for rainfall or weather information."
        },
        "otherWeatherInformationSource": {
          "type": "string",
          "description": "Specification for other weather information source."
        },
        "farmDecisionChallenge": {
          "type": "string",
          "description": "Open-ended response describing biggest farm decision challenge."
        },
        "likesSoilwise": {
          "type": "string",
          "description": "Overall experience response (Yes, Somewhat, Not yet)."
        },
        "wouldUse": {
          "type": "string",
          "description": "Usage intent response."
        },
        "willingnessToPay": {
          "type": "string",
          "description": "Selected price tier."
        },
        "removeOrModify": {
          "type": "string",
          "description": "Features or elements to change or remove."
        },
        "desiredFeatures": {
          "type": "string",
          "description": "Features desired in future versions."
        },
        "mostValuableFeature": {
          "type": "string",
          "description": "Most valuable feature identified."
        },
        "joinWaitingList": {
          "type": "boolean",
          "description": "Whether respondent joined the early access list."
        },
        "consent": {
          "type": "boolean",
          "description": "Consent to receive product updates."
        }
      },
      "required": ["submittedAt", "likesSoilwise", "wouldUse", "willingnessToPay"]
    }
  },
  "firestore": {
    "/soilwise_feedback/{feedbackId}": {
      "entity": "Feedback",
      "description": "Collection of all SoilWise AI feedback submissions. Public write-only, admin read/manage."
    }
  }
}
